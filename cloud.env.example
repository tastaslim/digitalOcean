# Copy this file to cloud.env and fill in your values.
# cloud.env is gitignored and must never be committed.

# Primary LLM — Digital Ocean serverless inference (OpenAI-compatible)
PRIMARY_LLM_BASE_URL=https://inference.do-ai.run/v1
PRIMARY_LLM_API_KEY=your-api-key-here
PRIMARY_LLM_MODEL=openai-gpt-oss-120b

# Candidate LLM — shadow target being evaluated
CANDIDATE_LLM_BASE_URL=https://inference.do-ai.run/v1
CANDIDATE_LLM_API_KEY=your-api-key-here
CANDIDATE_LLM_MODEL=openai-gpt-oss-120b

# How long (seconds) to wait for the candidate before recording a shadow timeout
SHADOW_TIMEOUT_SECONDS=30

# Maximum simultaneous background shadow tasks — excess are dropped (load shed)
MAX_CONCURRENT_SHADOWS=50
