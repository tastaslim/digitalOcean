# ---------------------------------------------------------------------------
# Copy this file to cloud.env and fill in your values.
# cloud.env is gitignored — never commit real keys.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Raw API keys — referenced by the LLM endpoint blocks below via ${VAR}
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Primary LLM  (user-facing, latency-sensitive)
# ---------------------------------------------------------------------------
PRIMARY_LLM_BASE_URL=https://api.openai.com/v1
PRIMARY_LLM_API_KEY=${OPENAI_API_KEY}
PRIMARY_LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Candidate LLM  (shadow evaluation, async)
# ---------------------------------------------------------------------------
CANDIDATE_LLM_BASE_URL=https://api.groq.com/openai/v1
CANDIDATE_LLM_API_KEY=${GROQ_API_KEY}
CANDIDATE_LLM_MODEL=llama-3.1-8b-instant

# Other OpenAI-compatible options:
#   DigitalOcean inference  PRIMARY_LLM_BASE_URL=https://inference.do-ai.run/v1
#   Together AI             PRIMARY_LLM_BASE_URL=https://api.together.xyz/v1
#   Mistral                 PRIMARY_LLM_BASE_URL=https://api.mistral.ai/v1

# ---------------------------------------------------------------------------
# Timeouts and concurrency
# ---------------------------------------------------------------------------
SHADOW_TIMEOUT_SECONDS=30
MAX_CONCURRENT_SHADOWS=50
PRIMARY_LLM_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Auth — leave blank to disable (dev / local testing)
# Set to a strong random secret in production.
# Clients must send:  X-API-Key: <value>
# ---------------------------------------------------------------------------
PROXY_API_KEY=

# ---------------------------------------------------------------------------
# Circuit breaker — primary LLM
# Opens after THRESHOLD consecutive failures; recovers after TIMEOUT seconds.
# ---------------------------------------------------------------------------
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Content truncation
# DB mismatch rows store a preview; full content lives in the S3 archive.
# ---------------------------------------------------------------------------
CONTENT_MAX_CHARS=2000

# ---------------------------------------------------------------------------
# Backend selection — swap any of these without touching application code.
# Valid values shown inline.
# ---------------------------------------------------------------------------
QUEUE_BACKEND=memory        # memory | sqs
CACHE_BACKEND=memory        # memory | redis
DB_BACKEND=sqlite           # sqlite | postgres
STORAGE_BACKEND=local       # local  | s3  | azure

# ---------------------------------------------------------------------------
# SQLite — active when DB_BACKEND=sqlite (default)
# Override to /data/mismatches.db in Docker
# ---------------------------------------------------------------------------
MISMATCH_DB_PATH=mismatches.db

# ---------------------------------------------------------------------------
# Local file storage — active when STORAGE_BACKEND=local (default)
# ---------------------------------------------------------------------------
LOCAL_STORAGE_DIR=.shadow_storage

# ---------------------------------------------------------------------------
# AWS — required when QUEUE_BACKEND=sqs or STORAGE_BACKEND=s3
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Leave blank for real AWS. Set to http://localhost:4566 when running LocalStack locally.
AWS_ENDPOINT_URL=

# SNS topic ARN for shadow event fan-out; SQS queues subscribe via Terraform/CDK
SNS_SHADOW_TOPIC_ARN=

# S3 archive bucket for shadow event replay
S3_BUCKET=
S3_PREFIX=shadow-events

# ---------------------------------------------------------------------------
# Redis — required when CACHE_BACKEND=redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# PostgreSQL — required when DB_BACKEND=postgres
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Azure Blob Storage — required when STORAGE_BACKEND=azure
# ---------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=
